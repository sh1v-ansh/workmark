# Workmark environment variables
#
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# .env.local is git-ignored — never commit real secrets.
# Only the variables below are actually read by the code. (The old
# GITHUB_OAUTH_* / STRIPE_* / NEXT_PUBLIC_APP_URL vars are no longer used.)

# ── Supabase (required) ─────────────────────────────────────────────
# Project URL + keys from Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, bypasses RLS. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (required) ─────────────────────────────────────────────────
# Base URL of this app. Used for auth email redirects and notification links.
# Local dev: http://localhost:3000   Prod: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Voyage embeddings (required) ────────────────────────────────────
# Powers skill-taxonomy embeddings. Get a key at https://www.voyageai.com
VOYAGE_API_KEY=

# ── GitHub App (required for repo scanning) ─────────────────────────
# Create a GitHub App (Settings → Developer settings → GitHub Apps).
# GITHUB_APP_ID:          the numeric App ID
# GITHUB_APP_PRIVATE_KEY: the generated .pem private key. Paste the full
#                         key; escaped \n newlines are accepted and
#                         un-escaped automatically by src/lib/github/app.ts.
# GITHUB_APP_WEBHOOK_SECRET: the webhook secret you set on the App
# GITHUB_APP_SLUG:        the App's URL slug (used to build the install link)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# ── Optional: Claude agents ─────────────────────────────────────────
# Enables the poster listing-assist draft and cold-start project briefs.
# Without it, those agent features are hidden and the app still runs.
ANTHROPIC_API_KEY=

# ── Optional: transactional email (Resend) ──────────────────────────
# Enables notification emails (application received/accepted, work
# submitted, engagement closed). Both must be set to turn email on.
# EMAIL_FROM example: "Workmark <notify@your-domain>"
RESEND_API_KEY=
EMAIL_FROM=

# Worker/cron authentication. REQUIRED.
# Without it, background GitHub scans are created but never run: kickJob()
# refuses to fire, and /api/jobs/step and /api/cron/jobs both return 500.
# Generate with: openssl rand -hex 32
# On Vercel, set this in project env vars — Vercel Cron sends it automatically
# as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
