# Supabase — get these from your Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used ONLY in server-side API routes, never exposed to the browser
# Get this from Supabase Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Base URL for verification email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# GitHub OAuth — create an OAuth app at https://github.com/settings/developers
# with callback URL: ${NEXT_PUBLIC_SITE_URL}/api/github/callback
# Scopes requested: read:user public_repo
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# Stripe Connect escrow — set to 'true' once legal review is complete.
# When 'false' (or unset), all /api/stripe/* routes return 501.
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
