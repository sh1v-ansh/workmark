# Supabase — get these from your Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used ONLY in server-side API routes, never exposed to the browser
# Get this from Supabase Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Base URL for verification email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
